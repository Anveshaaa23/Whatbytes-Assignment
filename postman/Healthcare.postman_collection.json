            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/mappings/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": \"{{patient_id}}\",\n  \"doctor\": \"{{doctor_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('mapping_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 List mappings",
      "request": {
