          }
        ],
        "url": "{{base_url}}/api/doctors/{{doctor_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Smith\",\n  \"specialization\": \"Internal medicine\"\n}",
          "options": {
            "raw": {
              "language": "json"
